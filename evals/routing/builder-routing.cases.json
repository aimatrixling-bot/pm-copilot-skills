{
  "suite": "builder-routing",
  "status": "draft",
  "cases": [
    {
      "id": "idea-to-agent-task-path",
      "input": "我是非程序员，想做一个个人项目，让 Codex 帮我实现，但我不知道怎么描述任务。",
      "expected_path": [
        "builder-router",
        "builder-frame",
        "builder-spec",
        "builder-agent-task"
      ],
      "must_include": ["non_goals", "verification", "human_approval_gates"]
    },
    {
      "id": "fuzzy-intent-to-spec-path",
      "input": "我们要把一个含糊的业务想法整理成能评审的需求。",
      "expected_path": [
        "builder-router",
        "builder-frame",
        "builder-spec"
      ],
      "must_include": ["problem", "spec_readiness", "acceptance_criteria"]
    },
    {
      "id": "fuzzy-intent-grill-frame-path",
      "input": "我想做一个 AI 工作台，但还没想清楚用户是谁、核心场景、non-goals 和成功标准，请先追问我，不要急着写完整方案。",
      "expected_path": [
        "builder-router",
        "builder-frame"
      ],
      "expected_mode": "grill_frame",
      "must_include": ["decision_tree", "recommended_defaults", "blocking_questions", "next_skill_input"]
    },
    {
      "id": "premature-agent-task-reroute-to-frame",
      "input": "直接帮我生成给 Codex 的 Agent Task Packet，但我只有一个想法：做一个个人 AI 项目管理工具，具体用户、范围和验收还没定。",
      "expected_path": [
        "builder-router",
        "builder-frame",
        "builder-spec",
        "builder-agent-task"
      ],
      "expected_mode": "grill_frame",
      "must_include": ["reroute", "spec_readiness", "human_decision_points", "not_ready"]
    },
    {
      "id": "premature-spec-reroute-to-frame",
      "input": "请直接写 PRD，但我现在只有一句话：想做一个更智能的销售跟进工具，用户、场景、范围和成功标准都还没定。",
      "expected_path": [
        "builder-router",
        "builder-frame",
        "builder-spec"
      ],
      "expected_mode": "not_ready_for_spec",
      "must_include": ["readiness_gate", "reroute_recommendation", "builder-frame", "next_skill_input"]
    },
    {
      "id": "premature-agent-task-reroute-to-spec",
      "input": "我已有 Feature Frame，但还没有验收标准、验证方式和 stop conditions。请生成 Codex Agent Task Packet。",
      "expected_path": [
        "builder-router",
        "builder-spec",
        "builder-agent-task"
      ],
      "expected_mode": "not_ready_for_agent_task",
      "must_include": ["readiness_gate", "reroute_recommendation", "builder-spec", "next_skill_input"]
    },
    {
      "id": "large-codex-work-plan-goal-path",
      "input": "请帮我把一个大仓库改造成可安装的 skill pack，我需要分阶段让 Codex 执行。",
      "expected_path": [
        "builder-router",
        "builder-plan-goal",
        "builder-agent-task"
      ],
      "must_include": ["milestones", "copy_ready_goal_prompt", "stop_conditions"]
    },
    {
      "id": "builder-plan-goal-to-prototype-handoff-path",
      "input": "我想做一个企业 AI Agent 应用原型，但目标还比较大，先帮我决定怎么让 Codex 开始。",
      "expected_path": [
        "builder-router",
        "builder-plan-goal",
        "builder-frame",
        "builder-prototype",
        "builder-agent-task"
      ],
      "must_include": ["Plan -> Goal", "builder-frame", "builder-prototype", "Milestone 1"]
    },
    {
      "id": "prototype-first-runnable-path",
      "input": "我已经有一个低风险页面想法，请直接做一个可运行原型，让我先看主流程和空状态。",
      "expected_path": [
        "builder-router",
        "builder-prototype",
        "builder-review"
      ],
      "expected_mode": "prototype_first",
      "must_include": ["prototype_first", "artifact_path", "states_covered", "gaps", "verification"]
    },
    {
      "id": "builder-plan-goal-to-review-handoff-path",
      "input": "Codex 已经做完第一个 milestone，我要判断结果能不能继续下一个 Goal。",
      "expected_path": [
        "builder-router",
        "builder-plan-goal",
        "builder-review"
      ],
      "must_include": ["verification", "evidence", "next Goal"]
    },
    {
      "id": "ui-spec-to-design-brief-path",
      "input": "把这个工作台需求整理成可交给原型和 Codex 实现的规格，同时保持组件、状态、响应式一致。",
      "expected_path": [
        "builder-router",
        "builder-spec",
        "builder-prototype",
        "builder-agent-task",
        "builder-review"
      ],
      "must_include": ["Design Brief", "Design Consistency Gate", "ui_states", "responsive_requirements"]
    },
    {
      "id": "pms-high-fidelity-prototype-containment-path",
      "input": "基于 PMS 领域模型和业务规则生成可运行高保真原型；业务规则可以补充说明，但不能侵入界面，要放到界面下方独立区域，并给出可调整的设计方案。",
      "expected_path": [
        "builder-router",
        "builder-spec",
        "builder-prototype",
        "builder-agent-task",
        "builder-review"
      ],
      "expected_mode": "boundary_first",
      "must_include": ["boundary_first", "Product Logic Containment Gate", "业务规则说明（非界面内容）", "mock honesty", "route readiness", "gaps", "verification"]
    },
    {
      "id": "prototype-spec-first-risk-path",
      "input": "帮我做一个权限管理原型，同时设计角色 API、数据库表、审计日志和生产迁移策略。",
      "expected_path": [
        "builder-router",
        "builder-prototype",
        "builder-spec"
      ],
      "expected_mode": "spec_first",
      "must_include": ["spec_first", "builder-spec", "gaps", "verification", "权限", "API"]
    },
    {
      "id": "prototype-to-spec-extraction-path",
      "input": "这个原型已经评审过了，请从 artifact_path、states_covered、gaps 和 verification 反向沉淀一份可以交给 Codex 的 Mini Spec。",
      "expected_path": [
        "builder-router",
        "builder-spec",
        "builder-agent-task",
        "builder-review"
      ],
      "expected_mode": "prototype_to_spec",
      "must_include": ["source_prototype", "extracted_from_prototype", "prototype_gaps", "verification_plan", "acceptance_criteria"]
    },
    {
      "id": "prototype-to-spec-high-risk-guard-path",
      "input": "这个权限管理原型已经有页面了，请把 gaps 里的角色 API、数据库表和审计日志直接变成工程交付规格。",
      "expected_path": [
        "builder-router",
        "builder-spec",
        "builder-agent-task"
      ],
      "expected_mode": "prototype_to_spec",
      "must_include": ["spec-first", "prototype_gaps", "open_questions", "risks", "权限", "API"]
    },
    {
      "id": "prototype-to-spec-review-path",
      "input": "我已经把 Visit 原型 brief 反向提取成 spec，请评审它有没有保留 prototype gaps、mock boundary 和 verification provenance。",
      "expected_path": [
        "builder-router",
        "builder-review",
        "builder-decision"
      ],
      "expected_mode": "prototype_to_spec_review",
      "must_include": ["prototype_to_spec_audit", "source_prototype", "prototype_gaps", "mock boundary", "verification provenance"]
    },
    {
      "id": "review-to-decision-record-path",
      "input": "评审发现这个里程碑证据不足，但我们决定先接受 mock 数据进入下一步，请把这个取舍和反转条件记录下来。",
      "expected_path": [
        "builder-router",
        "builder-review",
        "builder-decision"
      ],
      "must_include": ["evidence_audit", "tradeoffs", "reversal_conditions", "follow_up"]
    }
  ]
}
