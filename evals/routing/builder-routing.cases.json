{
  "suite": "builder-routing",
  "status": "draft",
  "cases": [
    {
      "id": "idea-to-agent-task-path",
      "input": "我是非程序员，想做一个个人项目，让 Codex 帮我实现，但我不知道怎么描述任务。",
      "expected_path": [
        "builder-router",
        "builder-frame",
        "builder-spec",
        "builder-agent-task"
      ],
      "must_include": ["non_goals", "verification", "human_approval_gates"]
    },
    {
      "id": "fuzzy-intent-to-spec-path",
      "input": "我们要把一个含糊的业务想法整理成能评审的需求。",
      "expected_path": [
        "builder-router",
        "builder-frame",
        "builder-spec"
      ],
      "must_include": ["problem", "spec_readiness", "acceptance_criteria"]
    },
    {
      "id": "fuzzy-intent-grill-frame-path",
      "input": "我想做一个 AI 工作台，但还没想清楚用户是谁、核心场景、non-goals 和成功标准，请先追问我，不要急着写完整方案。",
      "expected_path": [
        "builder-router",
        "builder-frame"
      ],
      "expected_mode": "grill_frame",
      "must_include": ["decision_tree", "recommended_defaults", "blocking_questions", "next_skill_input"]
    },
    {
      "id": "premature-agent-task-reroute-to-frame",
      "input": "直接帮我生成给 Codex 的 Agent Task Packet，但我只有一个想法：做一个个人 AI 项目管理工具，具体用户、范围和验收还没定。",
      "expected_path": [
        "builder-router",
        "builder-frame",
        "builder-spec",
        "builder-agent-task"
      ],
      "expected_mode": "grill_frame",
      "must_include": ["reroute", "spec_readiness", "human_decision_points", "not_ready"]
    },
    {
      "id": "premature-spec-reroute-to-frame",
      "input": "请直接写 PRD，但我现在只有一句话：想做一个更智能的销售跟进工具，用户、场景、范围和成功标准都还没定。",
      "expected_path": [
        "builder-router",
        "builder-frame",
        "builder-spec"
      ],
      "expected_mode": "not_ready_for_spec",
      "must_include": ["readiness_gate", "reroute_recommendation", "builder-frame", "next_skill_input"]
    },
    {
      "id": "premature-agent-task-reroute-to-spec",
      "input": "我已有 Feature Frame，但还没有验收标准、验证方式和 stop conditions。请生成 Codex Agent Task Packet。",
      "expected_path": [
        "builder-router",
        "builder-spec",
        "builder-agent-task"
      ],
      "expected_mode": "not_ready_for_agent_task",
      "must_include": ["readiness_gate", "reroute_recommendation", "builder-spec", "next_skill_input"]
    },
    {
      "id": "large-codex-work-plan-goal-path",
      "input": "请帮我把一个大仓库改造成可安装的 skill pack，我需要分阶段让 Codex 执行。",
      "expected_path": [
        "builder-router",
        "builder-plan-goal",
        "builder-agent-task"
      ],
      "must_include": ["milestones", "copy_ready_goal_prompt", "stop_conditions"]
    },
    {
      "id": "builder-plan-goal-to-prototype-handoff-path",
      "input": "我想做一个企业 AI Agent 应用原型，但目标还比较大，先帮我决定怎么让 Codex 开始。",
      "expected_path": [
        "builder-router",
        "builder-plan-goal",
        "builder-frame",
        "builder-prototype",
        "builder-agent-task"
      ],
      "must_include": ["Plan -> Goal", "builder-frame", "builder-prototype", "Milestone 1"]
    },
    {
      "id": "builder-plan-goal-to-review-handoff-path",
      "input": "Codex 已经做完第一个 milestone，我要判断结果能不能继续下一个 Goal。",
      "expected_path": [
        "builder-router",
        "builder-plan-goal",
        "builder-review"
      ],
      "must_include": ["verification", "evidence", "next Goal"]
    },
    {
      "id": "ui-spec-to-design-brief-path",
      "input": "把这个工作台需求整理成可交给原型和 Codex 实现的规格，同时保持组件、状态、响应式一致。",
      "expected_path": [
        "builder-router",
        "builder-spec",
        "builder-prototype",
        "builder-agent-task",
        "builder-review"
      ],
      "must_include": ["Design Brief", "Design Consistency Gate", "ui_states", "responsive_requirements"]
    },
    {
      "id": "pms-high-fidelity-prototype-containment-path",
      "input": "基于 PMS 领域模型和业务规则生成可运行高保真原型；业务规则可以补充说明，但不能侵入界面，要放到界面下方独立区域，并给出可调整的设计方案。",
      "expected_path": [
        "builder-router",
        "builder-spec",
        "builder-prototype",
        "builder-agent-task",
        "builder-review"
      ],
      "expected_mode": "high_fidelity_prototype",
      "must_include": ["design_plan", "Product Logic Containment Gate", "business_rule_notes", "rule_notes_placement", "preview_or_run_command", "nudge_options"]
    },
    {
      "id": "review-to-decision-record-path",
      "input": "评审发现这个里程碑证据不足，但我们决定先接受 mock 数据进入下一步，请把这个取舍和反转条件记录下来。",
      "expected_path": [
        "builder-router",
        "builder-review",
        "builder-decision"
      ],
      "must_include": ["evidence_audit", "tradeoffs", "reversal_conditions", "follow_up"]
    }
  ]
}
