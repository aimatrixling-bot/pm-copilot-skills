{
  "suite": "builder-routing",
  "status": "draft",
  "cases": [
    {
      "id": "idea-to-agent-task-path",
      "input": "我是非程序员，想做一个个人项目，让 Codex 帮我实现，但我不知道怎么描述任务。",
      "expected_path": [
        "builder-router",
        "builder-frame",
        "builder-spec",
        "builder-agent-task"
      ],
      "must_include": [
        "non_goals",
        "verification",
        "human_approval_gates"
      ]
    },
    {
      "id": "fuzzy-intent-to-spec-path",
      "input": "我们要把一个含糊的业务想法整理成能评审的需求。",
      "expected_path": [
        "builder-router",
        "builder-frame",
        "builder-spec"
