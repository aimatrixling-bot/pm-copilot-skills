{
  "schema_version": "0.1.0",
  "name": "ai-builder-os",
  "display_name": "AI Builder OS",
  "version": "0.7.0",
  "status": "m3.8-final-1.0-release-seal",
  "description": "AI-native builder operating system for turning fuzzy ideas, business problems, product requirements, and personal projects into agent-executable, verifiable, reusable build workflows.",
  "language_policy": "chinese-first",
  "package": {
    "npm_name": "pm-copilot-skills",
    "compatibility_policy": "keep npm package name during 1.0 convergence; expose AI Builder OS as product identity and command alias",
    "bins": [
      "pm-copilot-skills",
      "ai-builder-os"
    ]
  },
  "active_surface": {
    "type": "pure-builder-core",
    "skills": [
      "builder-router",
      "builder-plan-goal",
      "builder-frame",
      "builder-spec",
      "builder-prototype",
      "builder-agent-task",
      "builder-review",
      "builder-decision"
    ],
    "shared_resources": [
      "kernel/",
      "harness/",
      "memory/",
      "references/",
      "templates/",
      "adapters/"
    ],
    "excluded_from_package_surface": [
      "_archived/",
      "research/",
      "skills/pm-*",
      "skills/pdf",
      "skills/pptx",
      "skills/download-anything",
      "skills/references"
    ]
  },
  "architecture_layers": [
    "Builder Kernel",
    "Execution Harness",
    "Memory & Evolution",
    "Core Skills",
    "Scenario Bundles",
    "References & Templates",
    "Eval System",
    "Runtime Adapters"
  ],
  "bundles": [
    {
      "name": "ai-builder-os-core",
      "path": "bundles/core/manifest.json"
    }
  ],
  "runtime_adapters": [
    "codex",
    "claude-code",
    "generic-agent"
  ],
  "export": {
    "script": "scripts/export-ai-builder-os.js",
    "validator": "scripts/validate-runtime-adapters.js",
    "targets": [
      {
        "name": "codex",
        "adapter_manifest": "adapters/codex/adapter.json",
        "layout": "flat-skill-root"
      },
      {
        "name": "claude-code",
        "adapter_manifest": "adapters/claude-code/adapter.json",
        "layout": "flat-skill-root"
      },
      {
        "name": "generic-agent",
        "adapter_manifest": "adapters/generic-agent/adapter.json",
        "layout": "package-root"
      }
    ]
  },
  "release_gates": [
    "npm run validate:builder-os",
    "npm run validate:package-surface",
    "npm run validate:runtime-adapters",
    "npm run validate:trigger-descriptions",
    "npm run validate:dual-package-dry-run",
    "npm run validate:codex-install",
    "npm run validate:doctor-preference-e2e",
    "npm run test:doctor-preference-e2e",
    "npm pack --dry-run --json"
  ]
}
